# Copy to .env and fill in the keys you have. ALL keys are optional:
# with no keys the pipeline runs on the deterministic rule-based
# extraction tier (tier 0) and the unauthenticated GitHub rate limit.

# Phase III -- LLM extraction tiers (fallback chain, in this order)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Per-request character budget for LLM payloads (413 guard)
LLM_MAX_CHARS_PER_REQUEST=12000

# Raises GitHub API limit from 60/hr to 5000/hr for star counts
GITHUB_TOKEN=

# Path to the Papers With Code links-between-papers-and-code JSON
PWC_LINKS_PATH=data/pwc_links.json
